---
yaml-files:
  - '*.yaml'
  - '*.yml'
  - '.yamllint'

# Only this repository's own YAML is ours to lint. Without this, `yamllint .`
# walks the docs site's dependencies and reports hundreds of problems from
# vendored files, so `task lint` gives a different answer depending on whether
# anyone has installed the docs site.
ignore: |
  website/node_modules/
  website/build/
  website/.docusaurus/
  node_modules/

rules:
  braces:
    level: warning
    max-spaces-inside: 1
  brackets: enable
  colons: enable
  commas: enable
  comments:
    level: warning
  comments-indentation:
    level: warning
  document-end: disable
  document-start: disable
  empty-lines: enable
  empty-values: disable
  hyphens: enable
  indentation: disable
  key-duplicates: enable
  key-ordering: disable
  line-length: disable
  new-line-at-end-of-file: enable
  new-lines: enable
  octal-values: disable
  quoted-strings: disable
  trailing-spaces: enable
  truthy: disable
